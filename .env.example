# VectorBTC Environment Configuration Template
APP_NAME=vectorbtc
APP_ENV=development

# Database (SQLite with async support, container persistent path)
DATABASE_URL=sqlite+aiosqlite:////app/data/vectorbtc.db

# Market Data Source
BINANCE_BASE_URL=https://api.binance.com
SYMBOL=BTCUSDT
INTERVAL=5m
SCHEDULER_INTERVAL_MINUTES=5

# Secret key for encrypting AI API keys
SECRET_KEY=replace-with-a-32-char-or-longer-secret-key-abcdef123456

# Container Host Ports
BACKEND_PORT=8009
FRONTEND_PORT=8029

# Compose Network Subnet (must be unique per project on the shared host)
COMPOSE_SUBNET=10.253.241.0/28
